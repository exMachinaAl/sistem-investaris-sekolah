APP_NAME="Sistem Inventaris Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_inventaris_sekolah
DB_USERNAME=root
DB_PASSWORD=

BCRYPT_ROUNDS=12
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# HARUS DIISI sebelum php artisan db:seed (ganti dengan milik Anda)
SEED_ADMIN_NAME="Admin Sarpras"
SEED_ADMIN_EMAIL=admin@sekolah.test
SEED_ADMIN_PASSWORD=
